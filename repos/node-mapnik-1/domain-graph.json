  "nodes": [
    {
      "id": "domain:tile-rendering",
      "type": "domain",
      "name": "Tile Rendering",
      "summary": "Handles incoming web-map tile requests for the Tree Tracker map. It parses x/y/z tile coordinates, builds a Mapnik map instance with the correct envelope and style, renders the PostGIS features, and returns a PNG tile.",
      "tags": [
        "tile-server",
        "http",
        "rendering",
        "geospatial"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Tile (x/y/z)",
          "Map instance",
          "PNG image",
          "Bounding-box envelope"
        ],
        "businessRules": [
          "Zoom-level settings must be present at startup or the server refuses to boot",
          "Each request builds a fresh Mapnik map for its tile envelope"
        ],
        "crossDomainInteractions": [
          "Delegates data selection to Map Query Building",
          "Uses Style & Projection Config for the Mapnik XML and projection",
          "Calls Native Rendering Engine to rasterize the map"
        ]
      }
    },
    {
      "id": "domain:map-query-building",
      "type": "domain",
      "name": "Map Query Building",
      "summary": "Selects and assembles the correct PostGIS SQL for a tile request. A Map controller inspects request settings (tree id, user, wallet, timeline, zoom target) and instantiates the matching SQL query-builder from a case-based class hierarchy.",
      "tags": [
        "query-builder",
        "postgis",
        "sql",
        "orchestrator"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "SQL query builder (SQLCase/SQLZoomTarget/SQLTree)",
          "Request settings",
          "Tree",
          "Wallet",
          "Timeline range"
        ],
        "businessRules": [
          "The builder case is chosen from request settings (tree/user/wallet/timeline/zoom-target)",
          "Zoom-target and clustered variants override the base query per zoom level",
          "Queries are bounding-box constrained to the tile envelope"
        ],
        "crossDomainInteractions": [
          "Invoked by Tile Rendering to fetch tile data",
          "Executes queries through Database Access"
        ]
      }
    },
    {
      "id": "domain:style-projection-config",
      "type": "domain",
      "name": "Style & Projection Config",
      "summary": "Generates the Mapnik XML style for each tile and provides the spherical-mercator projection. It injects zoom-aware SQL and the database connection into a PostGIS datasource template, and converts tile coordinates to geographic envelopes.",
      "tags": [
        "config",
        "xml",
        "mapnik",
        "projection",
        "geospatial"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Mapnik XML template",
          "PostGIS datasource",
          "SQL CDATA parameter",
          "Zoom level",
          "Projection constants"
        ],
        "businessRules": [
          "Clustered SQL is used at low zoom and per-tree SQL at high zoom",
          "The SQL is injected into the postgis.xml datasource CDATA table parameter",
          "Projection constants are precached per zoom level"
        ],
        "crossDomainInteractions": [
          "Supplies style XML and envelopes to Tile Rendering",
          "Embeds the Database Access connection into the datasource"
        ]
      }
    },
    {
      "id": "domain:database-access",
      "type": "domain",
      "name": "Database Access",
      "summary": "Provides pooled, cached access to the PostGIS database. It wraps a PostgreSQL connection pool with an LRU cache and coalesces identical in-flight queries to avoid duplicate concurrent reads.",
      "tags": [
        "database",
        "postgis",
        "caching",
        "connection-pool"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Connection pool",
          "LRU cache",
          "Query result",
          "In-flight query queue"
        ],
        "businessRules": [
          "Identical concurrent queries are coalesced into one database read",
          "Completed results populate the LRU cache for reuse"
        ],
        "crossDomainInteractions": [
          "Serves query results to Map Query Building",
          "Connection string is injected by Style & Projection Config"
        ]
      }
    },
